)

print(f"Incertidumbre de imagen: ±{sigma_di0:.4f} cm")
print(f"Incertidumbre de magnificación: ±{sigma_ML0:.4f}")

print("\nEcuaciones utilizadas:")
print("Ecuación de Gauss: 1/f = 1/do + 1/di")
print("Distancia imagen: di = (f*do)/(do-f)")
print("Derivada: ddi/ddo = -(di/do)^2")
print("Magnificación longitudinal: ML = -(di/do)^2")

